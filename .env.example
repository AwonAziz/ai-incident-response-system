# ── AI Incident Response System — Environment Config ──────────────────
# Copy to .env and adjust. Never commit the real .env.
# Every value below is optional: unset values fall back to the defaults in
# config/settings.py, and telemetry thresholds live in config/cloud_profiles.yaml.

# Pipeline timing
COLLECTION_INTERVAL=5        # seconds between metric collections
DEDUP_WINDOW=60              # seconds before the same problem re-alerts
AUTO_RESOLVE_MINUTES=10      # auto-resolve MEDIUM/LOW incidents after N idle minutes
INJECT_EVERY_TICKS=6         # with --inject-anomaly, degrade a resource every N ticks

# ML model
MODEL_CONTAMINATION=0.02     # expected anomaly fraction (0.01-0.1; lower = fewer false pages)
MODEL_N_ESTIMATORS=150       # forest size (more = slower, slightly better)
BASELINE_SAMPLES=500         # collection rounds used to train the model
HISTORY_WINDOW=30            # rolling window length per metric series
MIN_HISTORY=5                # samples required before ML scoring is trusted
ML_MIN_CONFIDENCE=0.6        # ML-only detections below this are ignored (rule breaches always pass)

# Drift watch (drift_score > threshold and enough batches seen -> retrain)
DRIFT_THRESHOLD=0.35
DRIFT_MIN_BATCHES=10

# Control API
API_ENABLED=false
API_HOST=0.0.0.0
API_PORT=8080

# Notifications (leave blank to disable; blank channels report as "skipped")
SLACK_WEBHOOK_URL=
PAGERDUTY_ROUTING_KEY=
WEBHOOK_URL=
EMAIL_TO=
EMAIL_FROM=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
NOTIFIER_TIMEOUT_SECONDS=5
NOTIFIER_MAX_RETRIES=2
NOTIFIER_COOLDOWN_SECONDS=5

# Output
QUIET_MODE=false             # suppress LOW severity console alerts
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
RANDOM_SEED=42               # fixed seed makes runs reproducible

# Paths (defaults live in the project directory)
# MODEL_PATH=models/isolation_forest.pkl
# LOG_DIR=logs